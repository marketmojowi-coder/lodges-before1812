{
  "_note": "Public sites checked every day by .github/workflows/site-check.yml. Read-only: the check loads pages, it never changes a site. warn_only sites report but do not fail the run. allow_markers lists record markers (exact pattern text from RECORD_MARKERS) the owner approved for that site, e.g. the free Virginia Forge index (owner, Nov 11 2026): \"allow_markers\": [\"\\\"records\\\"\\\\s*:\\\\s*\\\\[\"]. expect / expect_og_image / forbid: text that must be on the home page, the share picture it must use, and text that must never appear on any page. house_terms: words that must never show on any public page (regex on visible text); warn_only terms are reported, not failed.",
  "sites": [
    {
      "name": "Lodges before 1812 (this repo's public page)",
      "url": "https://marketmojowi-coder.github.io/lodges-before1812/"
    },
    {
      "name": "GeoStone",
      "url": "https://cornerstone-map-7d25b.web.app/"
    },
    {
      "name": "Fraternal Vault (test only, never changed here)",
      "url": "https://atlas-223f5.web.app/"
    },
    {
      "name": "Market Mojo main site",
      "url": "https://mktmojox-site-f6f7a.web.app/"
    },
    {
      "name": "marketmojo.store site",
      "url": "https://marketmojo-store-f6f7a.web.app/"
    },
    {
      "name": "saharsky.com site",
      "url": "https://saharsky-f6f7a.web.app/"
    },
    {
      "name": "marketmojollc.com site",
      "url": "https://marketmojollc-f6f7a.web.app/"
    },
    {
      "name": "mmojo.co site",
      "url": "https://mmojo-co-f6f7a.web.app/"
    },
    {
      "name": "mktmojox.com (custom domain)",
      "url": "https://mktmojox.com/",
      "warn_only": true
    },
    {
      "name": "Lost Capitol (free app; records approved public)",
      "url": "https://lost-capitol.web.app/",
      "expect": [
        "Open the app",
        "Virginia State Capitol, 1779–1811"
      ],
      "expect_og_image": "og-image.jpg",
      "forbid": [
        "Open the preview",
        "Paid edition",
        "Sign in or create an account"
      ],
      "allow_markers": [
        "\"records\"\\s*:\\s*\\[",
        "\\bOriginal: National Archives",
        "\\bHeld at:",
        "window\\.CTI_DATA",
        "\"ph\"\\s*:"
      ]
    },
    {
      "name": "Virginia Forge (free index)",
      "url": "https://marketmojowi-coder.github.io/virginia-forge/",
      "allow_markers": [
        "\"records\"\\s*:\\s*\\["
      ]
    },
    {
      "name": "Federal City landing page (company site)",
      "url": "https://mktmojox-site-f6f7a.web.app/federal-city/"
    },
    {
      "name": "Civic Atlas page (company site)",
      "url": "https://mktmojox-site-f6f7a.web.app/civic-atlas/"
    },
    {
      "name": "Virginia Forge page (company site)",
      "url": "https://mktmojox-site-f6f7a.web.app/virginia-forge/",
      "allow_markers": [
        "\"records\"\\s*:\\s*\\["
      ]
    }
  ],
  "max_pages_per_site": 30,
  "house_terms": [
    {
      "pattern": "\\bGeocStone\\b",
      "why": "old name: the app was renamed GeoStone (owner, Nov 20 2026)"
    },
    {
      "pattern": "\\bgeocach",
      "flags": "i",
      "why": "never say geocaching in ads",
      "warn_only": true
    },
    {
      "pattern": "Posner Library",
      "why": "the name is Stephen J. Ponzillo Jr. Memorial Library and Museum"
    },
    {
      "pattern": "edit(?:ed|or|ors)\\b[^.\\n]{0,80}(?:Withrow|Brent Morris)|(?:Withrow|Brent Morris)[^.\\n]{0,80}\\bedit(?:ed|or|ors)\\b",
      "flags": "i",
      "why": "Josh Withrow and Brent Morris are never credited as editors"
    },
    {
      "pattern": "\\b104 (?:corner)?stones\\b",
      "why": "stale figure: GeoStone has 533 stones"
    },
    {
      "pattern": "\\b291 people\\b",
      "why": "stale figure from the old cornerstones list"
    },
    {
      "pattern": "\\(photo \\d{5,}\\)",
      "why": "working note left in record text"
    },
    {
      "pattern": "Thomas Saharsky\\b|T\\. M\\. Saharsky",
      "why": "the author is Thomas M. Saharsky",
      "warn_only": true
    }
  ]
}