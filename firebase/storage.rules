rules_version = '2';
// The data set (data/data.json) opens only to paying members and editors. Uploads only through the admin script.
service firebase.storage {
  match /b/{bucket}/o {
    match /data/{file} {
      allow read: if request.auth != null && (request.auth.token.stripeRole == "member" || request.auth.token.editor == true);
      allow write: if false;
    }
  }
}
