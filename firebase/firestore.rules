rules_version = '2';
// Members: a one-time membership payment (claim member == true, set by functions/index.js or admin/set_member.py),
// an older Stripe subscription (claim stripeRole == "member"), or editors (claim editor == true).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function editor() { return signedIn() && request.auth.token.editor == true; }
    function member() { return signedIn() && (request.auth.token.member == true || request.auth.token.stripeRole == "member" || editor()); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }

    // Member number: written once by the member's own browser (cryptographic random, fixed format), read only by the
    // member and the editors, never changed. Deleted with the account.
    match /members/{uid} {
      allow read: if owner(uid) || editor();
      allow create: if owner(uid) && member()
        && request.resource.data.keys().hasOnly(["no", "created"])
        && request.resource.data.no is string && request.resource.data.no.matches("^CA(-[0-9A-HJKMNP-TV-Z]{5}){4}$")
        && request.resource.data.created == request.time;
      allow update: if false;
      allow delete: if owner(uid) || editor();
    }

    // Bins: anyone who is a member can see them; only editors create or change them.
    match /bins/{bin} {
      allow read: if member();
      allow write: if editor();
    }
    // Printed sources members may cite (Schultz, Harper, Dove ...): members read, editors keep the list.
    match /sources/{id} {
      allow read: if member();
      allow write: if editor();
    }
    // Facts: members add pending facts with a source; they read accepted facts and their own; editors review.
    match /facts/{id} {
      allow read: if editor() || (member() && (resource.data.status == "accepted" || resource.data.by == request.auth.uid));
      allow create: if member()
        && request.resource.data.keys().hasOnly(["bin", "man", "lodge", "year", "claim", "citation", "held_at", "source", "volume", "page", "status", "by", "by_name", "agent", "created"])
        && request.resource.data.status == "pending"
        && request.resource.data.by == request.auth.uid
        && request.resource.data.agent == false
        && request.resource.data.created == request.time
        && str(request.resource.data.citation, 6, 1500)
        && str(request.resource.data.held_at, 4, 400)
        && str(request.resource.data.claim, 4, 3000)
        && str(request.resource.data.bin, 1, 80)
        && (!("man" in request.resource.data) || str(request.resource.data.man, 0, 120))
        && (!("lodge" in request.resource.data) || str(request.resource.data.lodge, 0, 80))
        && (!("year" in request.resource.data) || str(request.resource.data.year, 0, 12))
        && (!("by_name" in request.resource.data) || str(request.resource.data.by_name, 0, 40));
      allow update: if editor()
        || (signedIn() && resource.data.by == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["by_name"])
            && str(request.resource.data.by_name, 0, 40));
      allow delete: if editor() || (signedIn() && resource.data.by == request.auth.uid && resource.data.status == "pending");
    }
    // Messages from the contact page: any signed-in person may send one, signed with their own uid and email; only editors
    // read and answer them. The sender may delete their own (Delete my account does). "expires" drives a Firestore TTL policy
    // (about twelve months), as the privacy policy says.
    match /messages/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["topic", "message", "by", "email", "created", "expires"])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.created == request.time
        && request.resource.data.expires is timestamp
        && request.resource.data.expires > request.time
        && request.resource.data.expires < request.time + duration.value(400, "d")
        && str(request.resource.data.topic, 3, 60)
        && str(request.resource.data.message, 10, 4000);
      allow read, delete: if editor() || (signedIn() && resource.data.by == request.auth.uid);
      allow update: if editor();
    }
    // Stripe extension data: a user sees only their own customer record and starts their own checkout.
    match /customers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      match /checkout_sessions/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && verified() && request.resource.data.keys().hasOnly(["price", "success_url", "cancel_url", "mode", "allow_promotion_codes", "automatic_tax"])
          && str(request.resource.data.price, 6, 80) && request.resource.data.get("mode", "payment") == "payment";
      }
      match /subscriptions/{id} { allow read: if signedIn() && request.auth.uid == uid; }
      match /payments/{id} { allow read: if signedIn() && request.auth.uid == uid; }
    }
    // Zelle, GoDaddy checkout or PayPal: the payee details and checkout links are set by the owner (admin/set_zelle.py)
    // and shown only to signed-in people, never in the code or on a public page. A buyer with a confirmed email files one
    // claim with the reference; only an editor marks it paid, and functions/index.js then switches the membership on.
    match /config/zelle {
      allow read: if signedIn();
      allow write: if false;
    }
    match /zelle_claims/{uid} {
      allow read: if owner(uid) || editor();
      allow create: if owner(uid) && verified()
        && request.resource.data.keys().hasOnly(["ref", "name", "email", "state", "method", "price", "tax", "total", "status", "created"])
        && request.resource.data.get("method", "zelle") in ["zelle", "godaddy", "paypal"]
        && request.resource.data.state is string && request.resource.data.state.size() == 2
        && request.resource.data.price == get(/databases/$(db)/documents/config/zelle).data.amount
        && request.resource.data.tax is int && request.resource.data.tax >= 0
        && request.resource.data.total == request.resource.data.price + request.resource.data.tax
        && request.resource.data.status == "pending" && request.resource.data.created == request.time
        && str(request.resource.data.ref, 6, 20) && str(request.resource.data.name, 2, 80)
        && request.resource.data.email == request.auth.token.email;
      allow update: if editor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "checked"])
        && request.resource.data.status in ["paid", "not_found"] && request.resource.data.checked == request.time;
      allow delete: if editor() || (owner(uid) && resource.data.status != "paid");
    }
    // Sales ledger: one row per membership sold (Stripe or Zelle), written only by functions/index.js. Editors read it.
    match /sales/{id} {
      allow read: if editor();
      allow write: if false;
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{p} { allow read: if true; }
      match /tax_rates/{t} { allow read: if true; }
    }
  }
}
